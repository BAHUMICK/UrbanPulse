# UrbanPulse Frontend Environment Configuration
#
# Option A: Direct backend connection with credentialed CORS.
# Set VITE_API_URL in the Vercel Dashboard -> Settings -> Environment Variables:
# VITE_API_URL=https://urbanpulse-api-8u36.onrender.com/api
# (Ensure Render backend CORS_ORIGINS includes your Vercel frontend origin).
#
# Option B (Default / Recommended for Vercel): Same-Origin Rewrite via frontend/vercel.json.
# Leave VITE_API_URL empty on Vercel; requests to /api/* are rewritten directly
# to https://urbanpulse-api-8u36.onrender.com/api/* by the Vercel edge proxy.
VITE_API_URL=

# Local development uses Vite's proxy (/api -> localhost:5000).
# Optional: override the local Vite proxy target if your backend runs on another port/host.
VITE_DEV_API_ORIGIN=http://localhost:5000
