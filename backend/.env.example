# UrbanPulse Backend Environment Configuration
PORT=5000

# PostgreSQL Database Credentials (Local or Hosted)
# Option A: Discrete Connection Parameters
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_NAME=urbanpulse
DB_SSL=false

# For a hosted PostgreSQL provider with a private CA, configure exactly one:
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# DB_SSL_CA_PATH=/run/secrets/postgres-ca.pem
# Remote databases always use TLS with certificate and hostname verification.

# Option B: Full Connection String (Standard on Render / Supabase)
# Port 5432 (Session Pooler) or Port 6543 (Transaction Pooler):
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Exact allowed browser origins in production (comma-separated).
# Configure on Render with your deployed Vercel frontend origin, e.g.:
# CORS_ORIGINS=https://urbanpulse-three.vercel.app
# Local Vite development origins (localhost:5173) are allowed automatically outside production.
# Leave unset in local development.
CORS_ORIGINS=

# Required for signed CSRF tokens. Generate a fresh random value of at least 32 bytes:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET=

# Use a mounted persistent directory on hosted deployments.
UPLOAD_DIR=
